{
	servers {
		timeouts {
			read_header 15s
			read_body 30s
		}
	}
}

{$RELAY_HOST} {
	encode zstd gzip

	request_body {
		max_size 64MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "geolocation=(), payment=(), usb=(), microphone=(self), camera=(self), display-capture=(self)"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' https: wss:; manifest-src 'self'"
		-Server
	}

	reverse_proxy relay:8787
}
